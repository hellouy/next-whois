# ─────────────────────────────────────────────
# Database — Supabase PostgreSQL (required)
# ─────────────────────────────────────────────
# Session-mode pooler URL (port 6543) — used by the app for all queries.
# Found at: Supabase → Settings → Database → Connection string → Transaction mode
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:password@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# Non-pooling direct URL (port 5432) — used for migrations only.
# Found at: Supabase → Settings → Database → Connection string → Session mode
POSTGRES_URL_NON_POOLING=postgresql://postgres.your-project-id:password@db.your-project-id.supabase.co:5432/postgres

# Supabase project URL — found at Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — found at Settings → API → service_role (keep secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anonymous public key — found at Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────
# Redis — Aiven Redis (recommended)
# ─────────────────────────────────────────────
# Aiven uses rediss:// (TLS). Found at: Aiven Console → Service → Connection info → URI
# The app automatically uses TLS when URL starts with rediss://
REDIS_URL=rediss://default:your-password@your-project.aivencloud.com:12345

# Alternative: Upstash Redis (Vercel-optimised HTTP client, no persistent TCP)
# Found at: Upstash Console → Database → REST API
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-token

# ─────────────────────────────────────────────
# NextAuth (required)
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here
# Your production domain — must exactly match what users see in the browser
NEXTAUTH_URL=https://your-domain.com

# ─────────────────────────────────────────────
# Site Base URL (recommended)
# ─────────────────────────────────────────────
# Used in email links (password reset, subscription cancel, etc.)
# If not set, falls back to NEXTAUTH_URL
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ─────────────────────────────────────────────
# Admin Access (required)
# ─────────────────────────────────────────────
# Email address of the site administrator — this account gets full admin access.
# The user with this email must exist in the users table.
ADMIN_EMAIL=admin@yourdomain.com

# ─────────────────────────────────────────────
# Cron Security (recommended for production)
# ─────────────────────────────────────────────
# Protects /api/remind/process, /api/cron/ping, /api/cron/tld-scrape etc.
# Vercel automatically sends this as: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret

# ─────────────────────────────────────────────
# Email — Resend (required for password reset / welcome / reminder emails)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must match a verified domain on resend.com/domains
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─────────────────────────────────────────────
# GitHub Integration (optional — for admin git push feature)
# ─────────────────────────────────────────────
# Personal access token with repo write permission.
# Used by /api/admin/git-force-push to push code updates to GitHub.
# Can also be configured per-site in Admin → Settings.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=your-org/your-repo

# ─────────────────────────────────────────────
# Vercel Integration (optional — for domain management)
# ─────────────────────────────────────────────
# Used by /api/vercel/add-domain and /api/vercel/check-domain.
# Found at: Vercel → Account Settings → Tokens
# VERCEL_API_TOKEN=your-vercel-token
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxx
# VERCEL_TEAM_ID=team_xxxxxxxxxxxx  (only needed for team projects)

# ─────────────────────────────────────────────
# WHOIS / RDAP Settings
# ─────────────────────────────────────────────
# Query timeout in milliseconds
# Vercel Hobby plan: keep under 10000 (10s max function execution)
# Vercel Pro plan: can go up to 25000
WHOIS_TIMEOUT_MS=10000
# Max WHOIS redirect follows (0 = no follows, recommended for serverless)
NEXT_PUBLIC_MAX_WHOIS_FOLLOW=0
# Max query history items stored per user (-1 = unlimited)
NEXT_PUBLIC_HISTORY_LIMIT=-1

# ─────────────────────────────────────────────
# Database Connection Pool (optional tuning)
# ─────────────────────────────────────────────
# Max PostgreSQL connections in dev/self-hosted mode.
# On Vercel this is overridden to 2 automatically.
# PG_MAX_CONNECTIONS=5

# ─────────────────────────────────────────────
# Cold Start Optimisation (Vercel production)
# ─────────────────────────────────────────────
# Set to 1 on Vercel once the Supabase schema is fully provisioned.
# Skips the 3 DDL migration batches on every cold start, saving 200-400 ms.
# Safe after initial deploy — the schema never changes without a code deploy.
# SKIP_AUTO_MIGRATE=1

# ─────────────────────────────────────────────
# Observability — Alert Webhook (optional)
# ─────────────────────────────────────────────
# If set, the hourly check script posts failure-rate alerts here.
# Supports Discord (append /slack) and Slack incoming webhooks.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN/slack

# ─────────────────────────────────────────────
# Observability — Sentry error reporting (optional)
# ─────────────────────────────────────────────
# Create a project at sentry.io (free tier: 5k errors/month) → Client Keys (DSN).
# Server-side errors (API routes, libs) use SENTRY_DSN; browser errors use
# NEXT_PUBLIC_SENTRY_DSN. Both are no-ops when unset.
# SENTRY_DSN=https://xxxxx@o123.ingest.sentry.io/456
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o123.ingest.sentry.io/456
# Optional log filtering for structured NDJSON logs (debug|info|warn|error)
# LOG_LEVEL=info
# Source-map upload at build time (needs an auth token with org:write +
# project:write, e.g. Settings → Auth Tokens). Without a token the build
# skips upload entirely.
# SENTRY_AUTH_TOKEN=sntryu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# ─────────────────────────────────────────────
# Optional — Moz API (domain authority metrics)
# ─────────────────────────────────────────────
# MOZ_ACCESS_ID=
# MOZ_SECRET_KEY=

# ─────────────────────────────────────────────
# Optional — ICP Registration Check
# ─────────────────────────────────────────────
# ICP_API_URL=https://your-icp-api.com

# ─────────────────────────────────────────────
# Optional — AI Providers (for TLD lifecycle extraction)
# ─────────────────────────────────────────────
# These can also be set per-site in Admin → API Configuration.
# ZHIPU_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# SILICONFLOW_API_KEY=
# QIANFAN_API_KEY=
