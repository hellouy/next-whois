{
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/ping",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/remind/process",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/admin/process-email-queue",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/tld-scrape",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "src/pages/[...query].tsx": {
      "maxDuration": 15
    },
    "src/pages/api/lookup.ts": {
      "maxDuration": 30
    },
    "src/pages/api/lookup-stream.ts": {
      "maxDuration": 30
    },
    "src/pages/api/whois-servers.ts": {
      "maxDuration": 10
    },
    "src/pages/api/admin/tld-servers.ts": {
      "maxDuration": 10
    },
    "src/pages/api/admin/git-force-push.ts": {
      "maxDuration": 60
    },
    "src/pages/api/admin/expired-domains-crawl.ts": {
      "maxDuration": 60
    },
    "src/pages/api/admin/changelog-sync.ts": {
      "maxDuration": 30
    },
    "src/pages/api/admin/setup.ts": {
      "maxDuration": 30
    },
    "src/pages/api/admin/process-email-queue.ts": {
      "maxDuration": 60
    },
    "src/pages/api/admin/notify.ts": {
      "maxDuration": 60
    },
    "src/pages/api/remind/process.ts": {
      "maxDuration": 60
    },
    "src/pages/api/cron/ping.ts": {
      "maxDuration": 10
    },
    "src/pages/api/cron/tld-scrape.ts": {
      "maxDuration": 300
    },
    "src/pages/api/admin/subscription-sync.ts": {
      "maxDuration": 60
    },
    "src/pages/api/admin/tld-rules.ts": {
      "maxDuration": 90
    },
    "src/pages/api/admin/tld-registry.ts": {
      "maxDuration": 30
    },
    "src/pages/api/admin/tld-list.ts": {
      "maxDuration": 20
    },
    "src/pages/api/admin/api-keys.ts": {
      "maxDuration": 30
    },
    "src/pages/api/domain-value-ai.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
